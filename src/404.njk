<script>
    // The app used to be served from this address, and its pages are still bookmarked and, for /sync,
    // saved as the extension's endpoint in Manager businesses that installed it before the move. They
    // kept their paths on app.aussiebankfeeds.com, so the rest of the URL goes with them.
    const path = window.location.pathname;
    if (/^\/(profile|connections|connect|accounts|sync|install)(\/|$)/.test(path)) {
        window.location.replace("{{ site.app }}" + path + window.location.search + window.location.hash);
    }
</script>
<div class="hero not-found">
    <h1>Page not found</h1>
    <p>Sorry, we couldn't find the page you're looking for.</p>
    <div class="hero-actions">
        <a href="/" class="btn">Go back home</a>
        <a href="{{ site.app }}" class="btn btn-secondary">Sign In</a>
    </div>
</div>
